<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Four quarters, one per mode:
         top left Classic 2D (LCD green), top right Modern 2D (neon dark),
         bottom left 3D (navy), bottom right AR (room tone, like a camera image). -->
    <path android:fillColor="#9DB38A" android:pathData="M0,0h54v54h-54z"/>
    <path android:fillColor="#0B0E1A" android:pathData="M54,0h54v54h-54z"/>
    <path android:fillColor="#1B2340" android:pathData="M0,54h54v54h-54z"/>
    <path android:pathData="M54,54h54v54h-54z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="54"
                android:endX="108"
                android:endY="108"
                android:startColor="#6A5E66"
                android:endColor="#2C2A33"/>
        </aapt:attr>
    </path>

    <!-- Thin dark cross between the quarters -->
    <path android:strokeColor="#0B0E1A" android:strokeWidth="2.4"
        android:pathData="M54,0V108M0,54H108"/>

</vector>
